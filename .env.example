# Copy to .env and fill in. The .env file is git-ignored and never committed.
# This file is the authority for environment variables; config/settings.toml is
# the authority for everything that is not a secret.

# --- Required to boot -------------------------------------------------------

# Postgres. `postgres://` and `postgresql://` are both accepted and normalised.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Signs the creator session cookie. Any long random string; in production the
# hosting platform generates it.
SECRET_KEY=change-me-to-something-random

# --- Local development ------------------------------------------------------

# Overrides the derived https://<product.domain> for links in mails and pages.
BASE_URL=http://localhost:8000

# Where the integration tests run. Created by docker/init-test-db.sh.
DATABASE_URL_TEST=postgresql+psycopg://app:app@localhost:5432/app_test

# --- LLM (milestone M3) -----------------------------------------------------

# The gateway the application talks to. It never sees a provider key.
LLM_GATEWAY_URL=http://localhost:8080
# Virtual key: the application sends it, the gateway checks it. Same value on
# both sides; `config/bifrost.json` reads it from this variable.
LLM_GATEWAY_KEY=sk-bf-change-me

# Read by the gateway container only.
ANTHROPIC_API_KEY=
# Bootstraps the gateway's admin UI, which we never open.
BIFROST_SETUP_TOKEN=change-me

# --- E-mail (milestone M2 onwards) ------------------------------------------

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# A mailbox a human actually reads: reply-to fallback and contact-form
# recipient. Until the domain has an MX record, point this at an existing
# address, otherwise every contact mail hard-bounces.
SUPPORT_EMAIL=

# Overrides the derived post@mail.<domain> sender. Only until the domain is
# verified at the mail provider: then set onboarding@resend.dev, which can
# reach the provider account's own address and its test addresses.
SENDER_ADDRESS=

# --- YouTube (milestone M1 onwards) -----------------------------------------

YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts OAuth refresh tokens at rest. Comma-separated Fernet keys, newest
# first; the others stay for rotation.
TOKEN_ENCRYPTION_KEYS=

# Residential rotating proxy for the unofficial transcript provider. Empty
# locally: YouTube only blocks datacentre addresses.
TRANSCRIPT_PROXY_USERNAME=
TRANSCRIPT_PROXY_PASSWORD=

# --- Operations -------------------------------------------------------------

# Empty disables error tracking.
SENTRY_DSN=

# true in production; the setting alone picks JSON over console output.
LOGGING__JSON=false
LOGGING__LEVEL=INFO

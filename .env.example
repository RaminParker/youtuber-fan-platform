# Environment variables. Copy to .env and fill in; .env is git-ignored.
# Secrets and per-environment values only — every other setting lives in
# config/settings.toml. What each key is, where to get it and how to restrict
# it: README.md → "Schlüssel und ihre Rechte".
#
# Each block says when it is needed. Empty optional values are fine: the web
# and worker processes log `config.secret_missing` at start for anything they
# need and do not have.

# ============================================================================
# 1. Always needed
# ============================================================================

# Postgres (postgres:// and postgresql:// are both accepted).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# Signs the creator's session cookie. Long random string.
SECRET_KEY=change-me-to-something-random

# ============================================================================
# 2. Local development
# ============================================================================

# Base of every link in mails and pages (default: https://<product.domain>).
BASE_URL=http://localhost:8000
# Database for the integration tests (created by docker/init-test-db.sh).
DATABASE_URL_TEST=postgresql+psycopg://app:app@localhost:5432/app_test

# ============================================================================
# 3. Pipeline: YouTube and the LLM (needed for any video to be processed)
# ============================================================================

# Google Cloud API key for public video data. Restrict it to the YouTube Data API v3.
YOUTUBE_API_KEY=

# Where the app reaches the LLM gateway (Bifrost). The app never sees a provider key.
LLM_GATEWAY_URL=http://localhost:8080
# Shared secret between app and gateway ("virtual key"); same value on both sides.
LLM_GATEWAY_KEY=sk-bf-change-me
# The gateway's key for Anthropic. Must belong to a workspace. Gateway only.
ANTHROPIC_API_KEY=
# One-time token for the gateway's admin UI, which we never open. Random string.
BIFROST_SETUP_TOKEN=change-me

# ============================================================================
# 4. E-mail
# ============================================================================

# Resend key with "Sending access" only.
RESEND_API_KEY=
# Sender until the domain is verified at Resend (M9): onboarding@resend.dev.
SENDER_ADDRESS=
# A mailbox a human reads: reply-to fallback and contact-form recipient.
SUPPORT_EMAIL=
# Signs bounce webhooks from Resend (whsec_…). Needed from M9 (public URL).
RESEND_WEBHOOK_SECRET=

# ============================================================================
# 5. Official captions via the creator's own YouTube account (before the pilot)
# ============================================================================

# Google OAuth web client; redirect URI: <BASE_URL>/creator/youtube/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts stored OAuth tokens. Fernet keys, comma-separated, newest first.
TOKEN_ENCRYPTION_KEYS=

# ============================================================================
# 6. Production only (M9)
# ============================================================================

# Residential proxy for unofficial captions: cloud IPs are blocked by YouTube.
TRANSCRIPT_PROXY_USERNAME=
TRANSCRIPT_PROXY_PASSWORD=
# Sentry project DSN: turns every ERROR into an alert. Empty = off.
SENTRY_DSN=
# true in production: JSON logs instead of console output.
LOGGING__JSON=false
LOGGING__LEVEL=INFO
